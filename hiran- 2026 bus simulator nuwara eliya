    .side-mirror-left { left: 15px; transform: perspective(300px) rotateY(15deg); }
    .side-mirror-right { right: 15px; transform: perspective(300px) rotateY(-15deg); }
    .side-mirror canvas { width: 100% !important; height: 100% !important; }

    /* DASHBOARD BOTTOM PANEL */
    .dashboard-panel {
